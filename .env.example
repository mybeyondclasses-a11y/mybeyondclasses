# --- Public Site Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="MY BEYOND CLASSES"
NEXT_PUBLIC_COMPANY_EMAIL=mybeyondclasses@gmail.com

# --- Existing Supabase Project (jaggidlcnlbuwmetrtqb) ---
NEXT_PUBLIC_SUPABASE_URL=https://jaggidlcnlbuwmetrtqb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gvzWMP8JA-z7MVdqJZMI2Q_ZnTaOgkZ

# --- Server-Only Supabase & PostgreSQL Secrets ---
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.jaggidlcnlbuwmetrtqb.supabase.co:5432/postgres

# --- Google OAuth & Google Calendar API (Separate from Sign-In) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
